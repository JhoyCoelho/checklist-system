generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  password   String
  role       Role
  createdAt  DateTime    @default(now())
  checklists Checklist[]
  justifications Justification[]
  adminSignatures AdminSignature[]
}

model ChecklistTemplate {
  id         String              @id @default(uuid())
  name       String
  createdAt  DateTime            @default(now())
  checklists Checklist[]
  questions  ChecklistQuestion[]
}

model ChecklistQuestion {
  id         String            @id @default(uuid())
  templateId String
  question   String
  type       QuestionType
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])
}

model Checklist {
  id         String            @id @default(uuid())
  userId     String
  templateId String
  status     ChecklistStatus   @default(PENDING)
  createdAt  DateTime          @default(now())
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
  answers    ChecklistAnswer[]
  signature  Signature?
  justification Justification?
  adminSignature AdminSignature?
}

model ChecklistAnswer {
  id          String    @id @default(uuid())
  checklistId String
  questionId  String
  answer      String
  observation String?
  checklist   Checklist @relation(fields: [checklistId], references: [id])
}

model Signature {
  id          String    @id @default(uuid())
  checklistId String    @unique
  image       String
  checklist   Checklist @relation(fields: [checklistId], references: [id])
}

model Justification {
  id             String    @id @default(uuid())
  checklistId    String?   @unique
  userId         String
  role           String
  checklistType  String
  expectedDate   DateTime?
  filledDate     DateTime?
  expectedTime   String?
  filledTime     String?
  reason         String
  otherReason    String?
  description    String?
  signature      String
  createdAt      DateTime  @default(now())

  checklist      Checklist? @relation(fields: [checklistId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
}

model AdminSignature {
  id          String    @id @default(uuid())
  checklistId String    @unique
  adminId     String
  image       String
  createdAt   DateTime  @default(now())

  checklist   Checklist @relation(fields: [checklistId], references: [id])
  admin       User      @relation(fields: [adminId], references: [id])
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum QuestionType {
  STATUS        // OK / FALTANDO / DANIFICADO
  YES_NO        // SIM / NÃO
  TEXT          // campo livre
}

enum ChecklistStatus {
  PENDING
  COMPLETED
}
